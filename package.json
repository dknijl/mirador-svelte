{
  "name": "mirador",
  "version": "4.3.0",
  "description": "An open-source, web-based 'multi-up' viewer that supports zoom-pan-rotate functionality, ability to display/compare simple images, and images with annotations.",
  "type": "module",
  "main": "./dist/kokudor.min.js",
  "module": "./dist/mirador.es.js",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./demo/**"
  ],
  "exports": {
    "./src": "./src/index.js",
    ".": {
      "import": "./dist/mirador.es.js",
      "require": "./dist/kokudor.min.js"
    }
  },
  "scripts": {
    "build": "vite build --config vite.config.js && vite build --config vite-umd.config.js",
    "clean": "rm -rf ./dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node_modules/.bin/eslint ./ && npm run lint:translations",
    "lint:translations": "node ./scripts/i18n-lint.js",
    "prepublishOnly": "npm run build",
    "size": "size-limit",
    "start": "vite",
    "test": "npm run build && npm run lint && npm run size && vitest run"
  },
  "license": "Apache-2.0",
  "contributors": [
    "Drew Winget <scipioaffricanus@gmail.com> (https://aeschylus.net/)",
    "Jack Reed <phillipjreed@gmail.com> (https://www.jack-reed.com)"
  ],
  "repository": "https://github.com/ProjectMirador/mirador",
  "dependencies": {
    "@redux-devtools/extension": "^4.0.0",
    "@reduxjs/toolkit": "^2.12.0",
    "classnames": "^2.2.6",
    "copy-to-clipboard": "^3.3.1",
    "deepmerge": "^4.2.2",
    "dompurify": "^3.0.0",
    "i18next": "^21.0.0 || ^22.0.0 || ^23.0.0 || ^24.0.0 || ^25.0.0 || ^26.0.0",
    "lodash": "^4.17.11",
    "manifesto.js": "^4.3.4",
    "normalize-url": "^9.0.0",
    "openseadragon": "^6.1.1",
    "re-reselect": "^5.0.0",
    "redux": "^5.0.0",
    "redux-saga": "^1.1.3",
    "reselect": "^5.0.0",
    "svelte": "^5.59.1",
    "url": "^0.11.0",
    "uuid": "^8.1.0 || ^9.0.0 || ^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.0",
    "@size-limit/file": "^14.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "chalk": "^5.3.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "glob": "^13.0.6",
    "globals": "^16.0.0",
    "happy-dom": "^21.0",
    "jsdom": "^30.1.0",
    "msw": "^3.0.4",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.2.0",
    "redux-saga-test-plan": "^4.0.0-rc.3",
    "size-limit": "^14.0.0",
    "svelte-eslint-parser": "^1.10.1",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.16",
    "@testing-library/dom": {
      "pretty-format": "npm:@vitest/pretty-format@5.0.5"
    }
  }
}
