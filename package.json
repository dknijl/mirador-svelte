{
  "name": "mirador",
  "version": "4.3.0",
  "description": "An open-source, web-based 'multi-up' viewer that supports zoom-pan-rotate functionality, ability to display/compare simple images, and images with annotations.",
  "type": "module",
  "main": "./dist/kokudor.min.js",
  "module": "./dist/mirador.es.js",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./demo/**"
  ],
  "exports": {
    "./src": "./src/index.js",
    ".": {
      "import": "./dist/mirador.es.js",
      "require": "./dist/kokudor.min.js"
    }
  },
  "scripts": {
    "build": "vite build --config vite.config.js && vite build --config vite-umd.config.js",
    "clean": "rm -rf ./dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node_modules/.bin/eslint ./ && npm run lint:translations",
    "lint:translations": "node ./scripts/i18n-lint.js",
    "prepublishOnly": "npm run build",
    "size": "size-limit",
    "start": "vite",
    "test": "npm run build && npm run lint && npm run size && vitest run"
  },
  "license": "Apache-2.0",
  "contributors": [
    "Drew Winget <scipioaffricanus@gmail.com> (https://aeschylus.net/)",
    "Jack Reed <phillipjreed@gmail.com> (https://www.jack-reed.com)"
  ],
  "repository": "https://github.com/ProjectMirador/mirador",
  "dependencies": {
    "@redux-devtools/extension": "^4.0.1",
    "@reduxjs/toolkit": "^2.15.0",
    "classnames": "^2.5.1",
    "copy-to-clipboard": "^4.0.2",
    "dompurify": "^3.5.0",
    "i18next": "^27.2.4",
    "lodash": "^4.18.1",
    "manifesto.js": "^4.3.5",
    "normalize-url": "^10.0.0",
    "openseadragon": "^6.1.1",
    "re-reselect": "^6.0.0",
    "redux": "^5.0.1",
    "redux-saga": "^1.6.0",
    "reselect": "^5.3.0",
    "svelte": "^5.59.1",
    "url": "^0.11.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/user-event": "^14.6.13",
    "@vitest/ui": "^5.1.1",
    "chalk": "^6.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "redux-saga-test-plan": "^4.0.6",
    "size-limit": "^14.3.0",
    "svelte-eslint-parser": "^1.11.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.22",
    "@testing-library/dom": {
      "pretty-format": "npm:@vitest/pretty-format@5.1.1"
    }
  }
}
